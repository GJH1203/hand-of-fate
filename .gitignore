# ===== OS / Editor =====
.DS_Store
.idea/
.vscode/
*.iws
*.iml
*.ipr
*.swp
*~

# ===== Secrets =====
# Never commit real env files. Templates (.env.example) are the exception.
.env
.env.*
!.env.example

# ===== Java / Gradle (backend/) =====
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
bin/
out/
HELP.md

# ===== Node / Next.js (frontend/) =====
node_modules/
.next/
.vercel
/coverage
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ===== Logs =====
*.log
logs/

# ===== Monitoring runtime data (infra/monitoring/) =====
infra/monitoring/data/
infra/monitoring/prometheus-local.yml

# ===== Misc =====
*.tmp
*.temp
*.bak
*.pem

# Appended by `vercel link`. It is broader than the .env rules above and, being
# later in the file, would re-exclude the template — hence the negation.
.env*
!.env.example
