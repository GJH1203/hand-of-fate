# Template for infra/local/.env. Copy it, fill in the blanks, and keep the real file
# out of git.

# MongoDB Configuration (for docker-compose)
MONGO_USERNAME=admin
MONGO_PASSWORD=localdev

# MongoDB URI for the Spring Boot application and for running the backend test suite
MONGODB_URI=mongodb://admin:localdev@localhost:27017/card_game?authSource=admin

# Nakama Configuration
NAKAMA_HOST=localhost
NAKAMA_PORT=7349
NAKAMA_SERVER_KEY=defaultkey

# Spring Configuration
SPRING_PROFILES_ACTIVE=dev

# Authentication
# Supabase signs session tokens with an asymmetric key and publishes the public half, so
# the backend needs only the address to fetch it from — nothing here is a secret. Both
# values come from the Supabase project: Settings -> API.
# The backend will not start without the JWKS URI, which is deliberate: a service that
# cannot verify a token has no business answering requests.
SUPABASE_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1

# Supabase user ids allowed to reach /admin/**, comma separated.
# Empty means nobody is, and the admin endpoints answer 403 to every caller.
ADMIN_SUPABASE_USER_IDS=
