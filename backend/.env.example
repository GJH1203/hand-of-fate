# Production Environment Variables
# Copy this to .env and fill in real values

# MongoDB Configuration (for docker-compose)
MONGO_USERNAME=admin
MONGO_PASSWORD=your_secure_password_here

# MongoDB URI for Spring Boot application
MONGODB_URI=mongodb://admin:your_secure_password_here@localhost:27017/card_game?authSource=admin

# Nakama Configuration
NAKAMA_HOST=localhost
NAKAMA_PORT=7349
NAKAMA_SERVER_KEY=your_nakama_key_here

# Spring Configuration
SPRING_PROFILES_ACTIVE=production

# Authentication
# Supabase signs session tokens with an asymmetric key and publishes the public half, so
# nothing here is a secret — the backend needs only the address to fetch it from. Both
# values come from the Supabase project under Settings -> API.
# The application will not start without the JWKS URI, which is deliberate: a service
# that cannot verify a token has no business answering requests.
SUPABASE_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1

# Supabase user ids allowed to reach /admin/**, comma separated.
# Empty means nobody is, and the admin endpoints answer 403 to every caller.
ADMIN_SUPABASE_USER_IDS=